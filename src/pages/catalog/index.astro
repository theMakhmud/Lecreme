---
import Layout from '../../layouts/Base.astro';
import categories from '../../data/category.json';
import products from '../../data/products.json';
import CategoryFilter from '../../components/category/CategoryFilter';
import Breadcrumbs from '../../components/layout/Breadcrumbs.jsx';
import { getPriceRange } from '../../lib/price';

const { minPrice, maxPrice } = getPriceRange(products);

const breadcrumbs = [
    { label: 'Главная', href: '/' },
    { label: 'Каталог', href: '/catalog/' },
];
---

<Layout title={"catalog"}>
    <div class="wrapper">
        <CategoryFilter client:load products={products} categories={categories} minPrice={minPrice} maxPrice={maxPrice} />
        <section class="product_grid">
            <div class="routing">
                <Breadcrumbs items={breadcrumbs} />
            </div>
        </section>
    </div>
</Layout>


<style>
    .wrapper {
        display: grid;
        grid-template-columns: 1fr 4fr;
    }

    .product_grid {
        padding: 14px 30px;
    }
</style>