---
import Layout from '../../layouts/Base.astro';
import categories from '../../data/category.json';
import products from '../../data/products.json';

import Catalog from '../../components/category/Catalog';
import { getPriceRange } from '../../lib/price';

// Границы цены по всему каталогу — для ползунка.
const { minPrice, maxPrice } = getPriceRange(products);
---

<Layout title={"catalog"}>
    <!--
        client:only="react" — остров не рендерится на сервере, только в браузере.
        Это осознанно: данные (и фильтр из URL) целиком клиентские, а серверного
        рендера здесь всё равно нет. Позже products/categories заменяются на запрос к Appwrite.
    -->
    <Catalog
        client:only="react"
        products={products}
        categories={categories}
        minPrice={minPrice}
        maxPrice={maxPrice}
    />
</Layout>
