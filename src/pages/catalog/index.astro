---
import Layout from '../../layouts/Base.astro';

import { getCollection } from 'astro:content';


const categories  = (await getCollection('categories')).map((c) => c.data)
const products  = (await getCollection('products')).map((p) => p.data)

import Catalog from './Catalog.jsx'
import { getPriceRange } from '../../lib/price';

const { minPrice, maxPrice } = getPriceRange(products);
---

<Layout
    title={"Каталог десертов на заказ — кондитерская Lecreme"}
    description={"Пирожные, десерты, булочки и чизкейки под заказ. Фильтр по категориям и цене, у каждой позиции — честный производственный срок изготовления."}>
    <Catalog client:load products={products} categories={categories} minPrice={minPrice} maxPrice={maxPrice} />
</Layout>

