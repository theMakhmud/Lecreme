---
import Layout from '../../layouts/Base.astro';
import categories from '../../data/category.json';
import products from '../../data/products.json';

const poshtuchno = products.filter((v) => v.variants[0].sale_type == "poshtuchno").map((v) => {
    const variant = v.variants[0];
    return "price" in variant ? variant.price : null
}).filter((p): p is number => p !== null);

const po_vesu = products.filter((v) => v.variants[0].sale_type == "po_vesu").map((v) => {
    const variant = v.variants[0];
    return "price_per_100g" in variant ? variant.price_per_100g : null
}).filter((p): p is number => p !== null);

const tselikom = products.filter((v) => v.variants[0].sale_type == "tselikom_razmerami").map((v) => {
    const variant = v.variants[0];
    return "price" in variant ? variant.price : null
}).filter((p): p is number => p !== null);

const minPrice = Math.min(...poshtuchno, ...po_vesu, ...tselikom)
const maxPrice = Math.max(...poshtuchno, ...po_vesu, ...tselikom)
---

<Layout title={"category"}>
    <div class="wrapper">
        <aside class="tab_bar">
            <form method="get" action="/catalog/">
                <fieldset class="cat_filter">
                    <legend class="nav_title">Категории</legend>
                    <ul>
                        {categories.map((category) => (
                            <li>
                                <label class="cat_item">
                                    <input class="cat_input" type="checkbox" name="category" value={category.id} />
                                    <span class="name">{category.title}</span>
                                    <span class="length">{products.filter( (p) => p.category_id === category.id).length}</span>
                                </label>
                            </li>
                        ))}
                    </ul>
                </fieldset>

                <fieldset class="price_filter">
                    <legend class="nav_title">Цена</legend>
                    <div class="range">
                        <input data-min-range type="range" step="1000" min={minPrice} max={maxPrice}>
                        <input data-max-range type="range" step="1000" min={minPrice} max={maxPrice}>
                        <div class="slider">
                            <div data-progress class="progress">

                            </div>
                        </div>
                    </div>

                    <div class="price_wrapper">
                        <div class="range_input">
                            <input data-min-input type="number" min={minPrice} max={maxPrice} placeholder="от">
                            <input data-max-input type="number" min={minPrice} max={maxPrice} placeholder="до">
                        </div>
                        <span>{minPrice} сум — {maxPrice} сум</span>
                    </div>
                </fieldset>
            </form>
        </aside>
        <section class="product grid">
            
        </section>
    </div>
</Layout>


<style>
    .wrapper {
        display: grid;
        grid-template-columns: 1fr 4fr;
    }

    .nav_title {
        font-size: 16px;
        font-weight: 600;
        color: var(--color-on-surface-muted);
        padding-bottom: 6px;
        border-bottom:1px solid var(--color-border);
    }

    .tab_bar {
        border-right: 1px solid var(--color-border) ;
        padding: 25px;
    }

    form {
        display: flex;
        flex-direction: column;
        gap: 30px;
    }

    fieldset {
        border: none;
    }

    legend {
        width: 100%;
    }

    .cat_filter {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .cat_filter ul {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 14px;
    }

    .cat_item {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
    }

    .cat_item .name {
        font-size: 16px;
        font-weight: 400;
        color: var(--color-border-strong);
    }

    .cat_item .length {
        margin-left: auto;
        font-size: 14px;
        font-weight: 400;
        color: var(--color-on-surface-muted);
    }

    .range_input {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .range_input input {
        padding: 8px 10px;
        font-size: 16px;
        color: var(--color-on-surface);
        border: 1px solid var(--color-border);
        transition: .2s;
    }

    .range_input input:focus-visible {
        outline: 2px solid var(--color-action);
        border-radius: 10px;
    }

    .cat_input {
        appearance: none;
        -webkit-appearance: none;
        flex-shrink: 0;
        width: 18px;
        height: 18px;
        border: 1px solid var(--color-border);
        border-radius: 5px;
        display: grid;
        place-content: center;
        cursor: pointer;
        transition: background-color 0.15s ease, border-color 0.15s ease;
    }

    .cat_input::before {
        content: "";
        width: 10px;
        height: 10px;
        transform: scale(0);
        transform-origin: center;
        transition: transform 0.15s ease;
        background: #fff;
        clip-path: polygon(14% 44%, 0 65%, 43% 100%, 100% 16%, 80% 0%, 43% 62%);
    }

    .cat_input:hover {
        border-color: var(--color-action);
    }

    .cat_input:checked {
        background: var(--color-action);
        border-color: var(--color-action-active);
    }

    .cat_input:checked::before {
        transform: scale(1);
    }

    .cat_input:focus-visible {
        outline: 2px solid var(--color-action);
        outline-offset: 2px;
    }

    .price_filter {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .price_wrapper {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .price_wrapper span {
        font-size: 14px;
        font-weight: 400;
        color: var(--color-focus-ring);
    }

    .range {
        display: grid;
        position: relative;
        margin-top: 14px;
    }

    .range input {
        grid-row: 2;
        grid-column: 1;
        pointer-events: none;
        appearance: none;
        background: transparent;
    }

    .range input::-webkit-slider-thumb {
        pointer-events: auto;
        appearance: none;

        width: 14px;
        height: 14px;
        background-color: var(--color-surface-muted);
        outline: 2px solid var(--color-focus-ring);
        border-radius: 50%;
        cursor: pointer;
    }

    .range input::-webkit-slider-thumb {

    }

    .slider {
        position: absolute;
        height: 6px;
        width: 100%;
        background-color: var(--color-action-subtle);
        top: 50%;
        transform: translateY(-50%);
        z-index: -1;
        border-radius: 3px;
        overflow: hidden;
    }

    .progress {
        height: 100%;
        background-color: var(--color-action);
        position: absolute;
    }

    .range input.active {
        z-index: 10;
    }
</style>

<script is:inline>
    const slider = document.querySelector(".price_filter")
    const progress = slider.querySelector('[data-progress]')
    const minRange = slider.querySelector('[data-min-range]')
    const maxRange = slider.querySelector('[data-max-range]')
    const minInput = slider.querySelector('[data-min-input]')
    const maxInput = slider.querySelector('[data-max-input]')

    const minPrice = Number(minRange.min)
    const maxPrice = Number(maxRange.max)

    const gap = 1000

    minRange.value = minPrice
    maxRange.value = maxPrice

    const toPercent = (value) => {
        return (value - minPrice) / (maxPrice - minPrice) * 100
    }

    const render = () => {
        const low = Math.min(Number(minRange.value), Number(maxRange.value))
        const high = Math.max(Number(minRange.value), Number(maxRange.value))

        minInput.value = low > minPrice ? low : ""
        maxInput.value = high < maxPrice ? high : ""

        progress.style.left = toPercent(low) + "%"
        progress.style.right = (100 - toPercent(high)) + "%"
    }

    minRange.addEventListener("input", () => {
        render()
    })

    maxRange.addEventListener("input", () => {
        render()
    })

    for (const range of [minRange, maxRange]) {
        range.addEventListener("pointerdown", () => {
            range.classList.add("active")
        })
    }

    document.addEventListener("pointerup", () => {
        minRange.classList.remove("active")
        maxRange.classList.remove("active")
    })

    render()
</script>