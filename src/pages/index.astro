---
import Layout from '../layouts/Base.astro';

import ProductCard from '../components/ProductCard';

import { getCollection } from 'astro:content';


const categories  = await getCollection('categories')
const products  = await getCollection('products')


function categoryLength(category: (typeof categories)[number]) {
    return (products.filter((p) => p.data.category_id == category.data.id).length)
}

const popular = products.filter(p => p.data.is_popular)



---

<Layout
    title={"Lecreme — торты, чизкейки и десерты на заказ"}
    description={"Торты, чизкейки, пирожные и булочки готовим под ваш заказ — без склада и предзаготовок. Выбирайте удобную дату получения при оформлении. Принимаем индивидуальные торты по вашему ТЗ."}
    keywords={"торт на заказ, заказать торт, чизкейк на заказ, десерты на заказ, пирожные на заказ, булочки на заказ, торт по индивидуальному заказу, кондитерская"}>
    <div class="wrapper">
        <section class="hero" aria-labelledby="hero-title">
            <div class="info">
                <span>Производство под заказ</span>
                <h1 id="hero-title">Всё готовится под заказ. Дату получения выбираете вы.</h1>
                <p>Мы не держим готовых остатков. Вы собираете заказ, система показывает свободные даты — с учётом срока изготовления и загрузки производства.</p>
                <div class="button">
                    <a href="#catalog" class="btn btn-primary">Перейти в каталог</a>
                    <a href="#how" class="btn btn-secondary">Свободные даты</a>
                </div>
                <div class="facts">
                    <div class="fact">
                        <div class="fact-value">от 5 часов</div>
                        <div class="fact-label">минимальный срок</div>
                    </div>
                    <div class="fact">
                        <div class="fact-value">14 дней</div>
                        <div class="fact-label">горизонт записи</div>
                    </div>
                    <div class="fact">
                        <div class="fact-value">по телефону</div>
                        <div class="fact-label">подтверждаем каждый заказ</div>
                    </div>
                </div>
            </div>

            <div class="img"></div>
        </section>

        <section class="categories">
            <h2>Категории</h2>
            <ul class="category_grid">
                {categories.map((category) => (
                    <li>
                        <article class="category">
                            <a href={`/category/${category.data.path?.toLowerCase()}`}>
                                <div class="thumb"></div>
                                <div class="meta">
                                    <h3>{category.data.title}</h3>
                                    <p>{categoryLength(category)}</p>
                                </div>
                            </a>
                        </article>
                    </li>
                ))}
            </ul>
        </section>

        <section class="popular_category">
            <div class="head">
                <h2>Популярное</h2>
                <a href="/category/">
                    Весь каталог
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-narrow-right"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M5 12l14 0" /><path d="M15 16l4 -4" /><path d="M15 8l4 4" /></svg>
                </a>
            </div>
            <ul class="product_cards">
                {popular.map( (product) => (
                    <ProductCard product={product.data} />
                ))}
            </ul>

        </section>

        <section class="custom_order">
            <div class="text">
                <span>Индивидуальный заказ</span>
                <h2>Торт по вашему техническому заданию</h2>
                <p>Ярусы, вес, начинка, надпись, цветы, фигурки, корпоративная символика. Такой торт не кладётся в корзину: сначала обсуждаем задачу и дату, затем считаем стоимость и фиксируем её в заявке.</p>
                <div>
                    <div>
                        <p>Срок</p>
                        <span>от 72 часов</span>
                    </div>
                    <div>
                        <p>Вес</p>
                        <span>от 3 кг</span>
                    </div>
                    <div>
                        <p>Цена</p>
                        <span>согласуется отдельно</span>
                    </div>
                </div>
                <a href="/custom_order">
                    Оставить заявку
                </a>
            </div>
            <div class="photo">

            </div>

            <div class="wrapper">
                
            </div>
        </section>

        <section class="work_info">
            <div class="work_info_inner">
                <h2>Как это работает</h2>
                <ol class="info_cards">
                    <li>
                        <span class="step_num" aria-hidden="true">01</span>
                        <div class="step_body">
                            <h3>Выбираете десерт</h3>
                            <p>Складываете в корзину то, что нужно. У каждой позиции указан свой срок изготовления.</p>
                        </div>
                    </li>
                    <li>
                        <span class="step_num" aria-hidden="true">02</span>
                        <div class="step_body">
                            <h3>Выбираете свободную дату</h3>
                            <p>Показываем только те дни и часы, которые производство успевает: по самому долгому товару в корзине и загрузке дня.</p>
                        </div>
                    </li>
                    <li>
                        <span class="step_num" aria-hidden="true">03</span>
                        <div class="step_body">
                            <h3>Забираете в назначенное время</h3>
                            <p>Звоним, подтверждаем дату и время. К этому моменту заказ уже готов — забираете в точке выдачи.</p>
                        </div>
                    </li>
                </ol>
            </div>
        </section>

        <section class="reviews">
            <h2>Отзывы</h2>
            <div class="reviews-grid">
                <figure class="featured">
                    <span class="quote" aria-hidden="true">«</span>
                    <blockquote>Свадебный торт обсуждали неделю: ярусы, начинка, декор. Итоговую смету прислали до оплаты, в день свадьбы всё совпало с эскизом.</blockquote>
                    <figcaption><b>Мария и Павел</b><span>заказ · 3 августа</span></figcaption>
                </figure>
                <figure>
                    <span class="quote" aria-hidden="true">«</span>
                    <blockquote>Заказывала медовик на день рождения мамы за два дня. Позвонили, подтвердили время, к 10 утра всё было готово.</blockquote>
                    <figcaption><b>Анна К.</b><span>заказ · 12 марта</span></figcaption>
                </figure>
                <figure>
                    <span class="quote" aria-hidden="true">«</span>
                    <blockquote>Брали 40 капкейков на выпуск в школе. Сделали за один день, привезли в коробках по 6 штук — ничего не смазалось.</blockquote>
                    <figcaption><b>Дмитрий С.</b><span>заказ · 28 мая</span></figcaption>
                </figure>
            </div>
        </section>
        
        <section class="articles">
            <div class="head">
                <h2>Статьи</h2>
                <a href="">
                    Все статьи
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-narrow-right"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M5 12l14 0" /><path d="M15 16l4 -4" /><path d="M15 8l4 4" /></svg>
                </a>
            </div>
            <div class="article_grid">
                <a href="" class="article_featured">
                    <div class="img"></div>
                    <div class="text">
                        <span>Выбор торта</span>
                        <h3>Как рассчитать вес торта на 10, 20 и 50 человек</h3>
                        <p>Простая таблица: сколько граммов на гостя, если торт — единственный десерт и если есть другая выпечка.</p>
                    </div>
                </a>
                <div class="article_list">
                    <a href="">
                        <div>
                            <span>Производство</span>
                            <h3>Зачем торту «отстояться»: что происходит в холодильнике</h3>
                        </div>
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M5 12l14 0" /><path d="M15 16l4 -4" /><path d="M15 8l4 4" /></svg>
                    </a>
                    <a href="">
                        <div>
                            <span>Хранение</span>
                            <h3>Сколько хранится чизкейк и как везти его летом</h3>
                        </div>
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M5 12l14 0" /><path d="M15 16l4 -4" /><path d="M15 8l4 4" /></svg>
                    </a>
                    <a href="">
                        <div>
                            <span>Размеры</span>
                            <h3>Диаметр и персоны: как выбрать размер, чтобы хватило всем</h3>
                        </div>
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M5 12l14 0" /><path d="M15 16l4 -4" /><path d="M15 8l4 4" /></svg>
                    </a>
                </div>
            </div>
        </section>
    </div>
</Layout>

<style>
    .popular_category {
        padding: 30px var(--padding-side);
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .popular_category .head {
        display: flex;
        justify-content: space-between;

        a {
            display: flex;
            align-items: center;
            color: var(--color-action);
            font-size: 16px;
            font-weight: 600;
            gap: 8px;
        }
    }

    .popular_category .product_cards {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        gap: 16px;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .popular_category .product_cards > li {
        cursor: pointer;
    }
    

    @media (max-width: 768px) {
        .popular_category .product_cards {
            grid-template-columns: 1fr 1fr 1fr;
        }
    }


    .hero {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border: 1px solid var(--color-border);
        background-color: var(--color-surface);
        margin: 20px var(--padding-side) 0;
    }

    .hero .img {
        background-color: var(--color-plate);
        border-left: 1px solid var(--color-border);
    }

    .hero .info {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 24px;
        padding: 48px;
    }

    .hero .info span {
        font-size:11px;
        font-weight:600;
        letter-spacing:.12em;
        text-transform:uppercase;
        color:#141414;
    }

    .hero .info h1 {
        font-size: clamp(30px, 8vw + 10px, 44px);
        line-height: 1.18;
        letter-spacing: -0.01em;
        text-wrap: balance;
    }

    .hero .info p {
        font-size:16px;
        line-height:1.55;
        color:#454540;
        max-width:460px;
        text-wrap:pretty;
    }

    .btn {
        padding: 0 24px;
        height: 48px;
        display: flex;
        align-items: center;
        font-weight: 600;
        font-size: 14px;
        text-decoration: none;
        box-sizing: border-box;
        transition: .3s;
    }

    .button {
        display: flex;
        gap: 14px;
    }

    .btn-primary {
        background: var(--color-action);
        color: var(--color-neutral);
    }
    .btn-primary:hover {
        background: var(--color-action-hover, #17492F);
    }

    .btn-secondary {
        border: 1px solid var(--color-primary);
        background: transparent;
    }
    .btn-secondary:hover {
        background: var(--color-surface-muted);
    }
    .facts {
        width: auto;
        display: flex;
        margin-top: var(--spacing-lg, 24px);
    }

    .fact:first-child { padding-left: 0; }
    .fact:last-child { padding-right: 0; border-right: none; }

    .fact {
        padding: 16px 24px;
        border-right: 1px solid var(--color-border);
        border-top: 1px solid var(--color-border);
    }

    .fact-value {
        font-family: var(--font-mono), Menlo, monospace;
        font-weight: 600;
        font-size: 15px;
        line-height: 1.3;
        font-feature-settings: "tnum" 1;
    }

    .fact-label {
        font-size: 12px;
        line-height: 1.4;
        color: var(--color-on-surface-muted);
    }

    @media (max-width: 768px) {
        .hero {
            grid-template-columns: 1fr;
        }
    }
</style>


<style>
    .categories {
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 10px var(--padding-side);
    }

    .categories .category_grid {
        display: flex;
        justify-content: start;
        gap: 16px;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .category_grid > li {
        display: flex;
        flex: 0 1 228px;
    }

    .category_grid .category {
        display: flex;
        flex: 1;
    }

    .category_grid .category > a {
        display: flex;
        flex-direction: column;
        flex: 1;
        text-decoration: none;
        color: inherit;
        border: 1px solid var(--color-border);
        background-color: var(--color-surface);
        cursor: pointer;
    }

    .category_grid .category .thumb {
        aspect-ratio: 4 / 3;
        background-color: var(--color-plate);
    }

    .category_grid .category .meta {
        padding: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;

        h3 {
            color: var(--color-border-strong);
            font-size: 18px;
            font-weight: 600;
        }

        p {
            font-family: var(--font-mono), Menlo, monospace;
            font-size: 13px;
            font-weight: 500;
            color: var(--color-on-surface-muted);
        }
    }
</style>

<style>
    .wrapper {
        display: flex;
        flex-direction: column;
        gap: 30px;
    }

    .custom_order {
        padding: 20px 40px;
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    .custom_order .photo {
        background-color: var(--color-plate);
    }

    .custom_order .text {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 16px;
        padding: 30px 70px 30px 30px;
        border: 1px solid var(--color-border);
        background-color: var(--color-surface);
    }

    .custom_order .text > span {
        font-size:11px;
        font-weight:600;
        letter-spacing:.12em;
        text-transform:uppercase;
        color:#141414
    }

    .custom_order .text h2 {
        font-size: clamp(28px, 6vw + 8px, 36px);
        line-height: 1.22;
        letter-spacing: -0.01em;
        text-wrap: balance;
    }

    .custom_order .text p {
        font-size:16px;
        line-height:1.55;
        color:#454540;
        max-width:460px;
        text-wrap:pretty;
    }

    .custom_order .text > div {
        display: flex;
        justify-content: space-between;
        padding: 16px 0;
    }

    .custom_order .text > div div {
        display: flex;
        flex-direction: column;
        gap: 4px;

        span {
            font-family: var(--font-mono), Menlo, monospace;
            font-feature-settings: "tnum" 1;
            font-size: 15px;
            font-weight: 600;
            color: var(--color-border-strong);
        }

        p {
            font-size: 12px;
            font-weight: 400;
            color: var(--color-on-surface-muted);
        }
    }

    .custom_order .text a {
        width: 150px;
        text-align: center;
        padding: 14px 18px;
        border: none;
        font-size: 16px;
        font-weight: 600;
        background-color: var(--color-action);
        color: white;
    }

    .work_info {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        background-color: var(--color-plate);
        color: var(--color-primary);
    }

    .work_info_inner {
        max-width: 1320px;
        margin: 0 auto;
        padding: 30px var(--padding-side);
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .work_info .info_cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
    }


    .work_info .info_cards li {
        display: flex;
        flex-direction: column;
        gap: 18px;
        padding: 28px 25px;
        border-top: 1px solid var(--color-border);
        border-right: 1px solid var(--color-border);
    }

    .work_info .info_cards li:last-child {
        border-right: none;
    }

    .work_info .info_cards li:first-child {
        padding-left: 0;
    }

    .info_cards .step_num {
        font-family: var(--font-prata), Georgia, serif;
        font-size: 44px;
        line-height: 1;
        color: var(--color-action);
        font-weight: 600;
        padding-bottom: 14px;
        background-image: repeating-linear-gradient(90deg, var(--color-border) 0 6px, transparent 6px 12px);
        background-repeat: no-repeat;
        background-position: left bottom;
        background-size: 56px 1px;
    }

    .step_body {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .step_body h3 {
        font-size: 19px;
        font-weight: 600;
        line-height: 1.2;
        letter-spacing: -0.01em;
        text-wrap: balance;
    }

    .step_body p {
        font-size: 15px;
        line-height: 1.55;
        color: var(--color-secondary);
        max-width: 380px;
        text-wrap: pretty;
    }

    .reviews {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: 0px 40px 20px;
    }

    .reviews h2 {
        font-size: 26px;
        color: var(--color-border-strong);
    }

    .reviews-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        grid-auto-rows: 1fr;
        gap: 20px;
    }

    .reviews-grid figure {
        border: 1px solid var(--color-border);
        background-color: var(--color-surface);
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .reviews-grid .featured {
        grid-row: span 2;
        padding: 32px;
    }

    .reviews-grid .quote {
        font-family: var(--font-prata), Georgia, serif;
        font-size: 44px;
        line-height: 0.6;
        color: var(--color-primary);
    }

    .reviews-grid figure blockquote {
        margin: 0;
        font-size: 15px;
        line-height: 1.55;
        text-wrap: pretty;
        flex: 1;
    }

    .reviews-grid .featured blockquote {
        font-size: 19px;
        line-height: 1.5;
    }

    .reviews-grid figure figcaption {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 12px;
        border-top: 1px dashed var(--color-border);
        padding-top: 10px;
    }

    .reviews-grid figcaption b {
        font-size: 13px;
        font-weight: 600;
        color: var(--color-primary);
    }

    .reviews-grid figcaption span {
        font-family: var(--font-mono), Menlo, monospace;
        font-feature-settings: "tnum" 1;
        font-size: 12px;
        color: var(--color-on-surface-muted);
    }

    .articles {
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 20px 40px;
    }

    .articles .head {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .articles .head h2 {
        font-size:24px;
        letter-spacing:-0.01em;
    }

    .articles .head a {
        display: flex;
        align-items: center;
        color: var(--color-action);
        font-size: 16px;
        font-weight: 600;
        gap: 8px;
    }

    .articles .article_grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 32px;
        align-items: start;
    }

    .article_featured {
        display: flex;
        flex-direction: column;
        border: 1px solid var(--color-border);
        background-color: var(--color-surface);
        color: inherit;
    }

    .article_featured .img {
        background-color: var(--color-plate);
        aspect-ratio: 16 / 9;
    }

    .article_featured .text {
        padding: 18px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .article_featured .text span,
    .article_list a span {
        color: var(--color-on-surface-muted);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .article_featured .text h3 {
        font-size: 19px;
        font-weight: 600;
        line-height: 1.3;
    }

    .article_featured .text p {
        font-size: 14px;
        line-height: 1.5;
        color: var(--color-secondary);
    }

    .article_featured:hover h3 {
        color: var(--color-action);
    }

    .article_list {
        display: flex;
        flex-direction: column;
    }

    .article_list a {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding: 20px 0;
        border-bottom: 1px dashed var(--color-border);
        color: inherit;
    }

    .article_list a:first-child {
        padding-top: 4px;
    }

    .article_list a > div {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .article_list a h3 {
        font-size: 16px;
        font-weight: 600;
        line-height: 1.35;
        transition: color .2s;
    }

    .article_list a svg {
        flex-shrink: 0;
        color: var(--color-action);
